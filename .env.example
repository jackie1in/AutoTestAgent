# UI Test Agent - LLM Configuration
# Copy this file to .env and fill in your settings

# ===========================================
# Option 1: OpenAI (default)
# ===========================================
# OPENAI_API_KEY=sk-xxxxx

# ===========================================
# Option 2: OpenRouter (supports multiple models)
# ===========================================
# LLM_MODEL=google/gemini-2.5-pro-preview
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-v1-xxxxx

# ===========================================
# Option 3: GLM-5 (Zhipu AI) - Recommended for Chinese users
# ===========================================
# GLM-5 supports native JSON schema validation and reasoning/thinking mode
# Docs: https://docs.bigmodel.cn/cn/guide/start/concept-param#thinking
#
# Option A: Direct Zhipu API (recommended)
# Docs: https://docs.bigmodel.cn/cn/guide/develop/langchain/introduction
# LLM_MODEL=glm-5
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
# LLM_API_KEY=your-zhipu-api-key
#
# Option B: Via OpenRouter
# LLM_MODEL=glm-5
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-v1-xxxxx
#
# Thinking Mode Control:
# Thinking mode is now controlled via the `use_thinking` parameter in code:
#   get_llm(use_thinking=True)   # Enable reasoning mode
#   get_llm(use_thinking=False)  # Disable reasoning (default, faster)
#
# Note: OpenRouter does not support the 'thinking' control parameter.
# Use direct Zhipu API (Option A) for full control.
#
# Viewing Thinking Content:
# - Set LOG_LEVEL=INFO to see reasoning in logs
# - Example: INFO: [GLM-5 Thinking] Let me analyze...
#
# Docs: docs/glm5-thinking.md

# ===========================================
# Available Models on OpenRouter
# ===========================================
# google/gemini-2.5-pro-preview
# google/gemini-2.5-flash-preview
# anthropic/claude-3.5-sonnet
# anthropic/claude-3-opus
# openai/gpt-4o
# openai/gpt-4o-mini
# meta-llama/llama-3.1-405b-instruct

# ===========================================
# Other Settings (optional)
# ===========================================
# LLM_TEMPERATURE=0.0
# LOG_LEVEL=DEBUG  # DEBUG, INFO, WARNING, ERROR; default: INFO for cartography, WARNING for browser-use

# ===========================================
# Graph Agent (optional)
# ===========================================
# MAPPING_URL=https://the-internet.herokuapp.com/login
# MAPPING_OUTPUT=graph_agent/data/graph.json
# MAPPING_INVENTORY=graph_agent/data/element_inventory.json
# MAPPING_USERNAME=tomsmith
# MAPPING_PASSWORD=SuperSecretPassword!
# MAPPING_HEADLESS=false
# MAPPING_CHANNEL=chrome
# PLAYWRIGHT_CHANNEL=chrome
# PLAYWRIGHT_HEADLESS=false
# Browser window size, format WxH (default: 1920x1080)
# BROWSER_WINDOW_SIZE=1920x1080
# Minimum page load wait time in seconds (default: 0.1)
# BROWSER_MINIMUM_WAIT_PAGE_LOAD_TIME=0.1
# Wait between actions in seconds (default: 0.1)
# BROWSER_WAIT_BETWEEN_ACTIONS=0.1

# ===========================================
# Intent Inference Performance (optional)
# ===========================================
# Intent mode: "sync" (blocking, default) or "async" (deferred parallel inference)
# MAPPING_INTENT_MODE=async
# Async inference concurrency (default: 3, max: 10)
# MAPPING_INTENT_CONCURRENCY=3
# Skip refine pass for navigation.* keys (reduces 1 LLM call per step)
# MAPPING_SKIP_REFINE=true
# Skip thought distillation LLM call
# MAPPING_SKIP_DISTILL=true
# LLM call timeout in milliseconds (0 = no timeout)
# MAPPING_INTENT_TIMEOUT_MS=2000

# ===========================================
# Rate Limiting (optional)
# ===========================================
# Control LLM request rate to avoid hitting provider rate limits
# LLM_RATE_LIMIT_RPS=2        # Max 2 requests per second (e.g., OpenRouter free tier)
# LLM_RATE_LIMIT_RPS=0.5      # Max 1 request every 2 seconds (conservative)
# LLM_RATE_LIMIT_RPS=0        # Disable rate limiting (default)

# ===========================================
# Runtime Guard Configuration (optional)
# ===========================================
# Whether to enable runtime guards
# CARTOGRAPHY_RUNTIME_GUARD_ENABLED=true
# Max captcha attempts
# CARTOGRAPHY_GUARD_MAX_CAPTCHA_ATTEMPTS=3
# Max captcha failures
# CARTOGRAPHY_GUARD_MAX_CAPTCHA_FAILURES=2
# Max consecutive action failures
# CARTOGRAPHY_GUARD_MAX_ACTION_FAILURES=3
# Max consecutive blank/short DOM occurrences
# CARTOGRAPHY_GUARD_MAX_BLANK_DOM=3
# Network failure window threshold
# CARTOGRAPHY_GUARD_MAX_REQUEST_FAILURES=5
# 5xx response window threshold
# CARTOGRAPHY_GUARD_MAX_5XX=3
# 429 response window threshold
# CARTOGRAPHY_GUARD_MAX_429=2
# Network window duration in seconds
# CARTOGRAPHY_GUARD_NETWORK_WINDOW_SECONDS=60

# ===========================================
# Captcha Solve Mode (optional)
# ===========================================
# Captcha handling strategy:
# - auto: use graph_agent/cartography/captcha.py automatic recognition (default)
# - manual: pause ReAct flow and wait for console input, then continue same run
# CAPTCHA_SOLVE_MODE=auto

# ===========================================
# Extra System Prompt (optional)
# ===========================================
# Custom prompt appended to the ReAct explorer's system prompt.
# Use this to inject domain-specific behavioral hints, e.g.:
#   CARTOGRAPHY_EXTRA_SYSTEM_PROMPT=注意：本系统的导航菜单隐藏在图标按钮后面，请优先点击页面上的图标/icon元素来展开菜单，再探索菜单项。

# ===========================================
# Neo4j Configuration (optional)
# ===========================================
# Show Neo4j warning notifications (e.g. missing indexes, relationship types)
# NEO4J_WARN_NOTIFICATIONS=true

# Comma-separated list of extra HTML attributes to include in DOM serialization.
# Extends browser-use's DEFAULT_INCLUDE_ATTRIBUTES. Useful when JS patches set
# attributes not in the default list (e.g. aria-required from form-field detection).
# CARTOGRAPHY_INCLUDE_ATTRIBUTES=aria-required
